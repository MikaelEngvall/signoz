            "disabled": false,
            "legend": "All Services",
            "name": "A",
            "query": "SELECT toStartOfInterval(toDateTime(intDiv(unix_milli, 1000)), INTERVAL 900 SECOND) AS ts, max(value) AS value FROM signoz_metrics.samples_v4 s INNER JOIN signoz_metrics.time_series_v4 t ON s.fingerprint = t.fingerprint WHERE t.metric_name = 'cicd_pipeline_test_verdict' AND JSONExtractString(t.labels, 'cicd_test_case_group') = 'BOS' AND JSONExtractString(t.labels, 'cicd_test_case_type') = 'Health-Check' AND s.unix_milli >= {{.start_timestamp_ms}} AND s.unix_milli <= {{.end_timestamp_ms}} GROUP BY ts ORDER BY ts"
          }
        ],
